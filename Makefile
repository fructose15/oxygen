# Generated by ./configure for Linux
CC       := gcc
CXX      := g++
PREFIX   := /usr/local
CFLAGS   := -O2 -Wall -Wextra -fPIC -Isrc
CXXFLAGS := -O2 -std=c++17 -Wall -Wextra -fPIC -Isrc
LDFLAGS  := -lpthread -ldl

TARGET_BIN := oxygen
C_SRCS     := src/runtime.c
CXX_SRCS   := src/interpreter.cpp src/compiler.cpp src/ide_server.cpp src/main.cpp
OBJS       := build/runtime.o build/interpreter.o build/compiler.o build/ide_server.o build/main.o

.PHONY: all clean install test

all: $(TARGET_BIN)

build:
	mkdir -p build

build/runtime.o: src/runtime.c src/oxygen.h src/platform_config.h | build
	$(CC) $(CFLAGS) -c src/runtime.c -o build/runtime.o

build/interpreter.o: src/interpreter.cpp src/interpreter.hpp src/oxygen.h src/platform_config.h | build
	$(CXX) $(CXXFLAGS) -c src/interpreter.cpp -o build/interpreter.o

build/compiler.o: src/compiler.cpp src/interpreter.hpp src/oxygen.h src/platform_config.h | build
	$(CXX) $(CXXFLAGS) -c src/compiler.cpp -o build/compiler.o

build/ide_server.o: src/ide_server.cpp src/ide_server.hpp src/interpreter.hpp src/oxygen.h src/platform_config.h | build
	$(CXX) $(CXXFLAGS) -c src/ide_server.cpp -o build/ide_server.o

build/main.o: src/main.cpp src/interpreter.hpp src/ide_server.hpp src/oxygen.h src/platform_config.h | build
	$(CXX) $(CXXFLAGS) -c src/main.cpp -o build/main.o

$(TARGET_BIN): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $(TARGET_BIN) $(OBJS) $(LDFLAGS)

install: $(TARGET_BIN)
	mkdir -p $(PREFIX)/bin $(PREFIX)/include $(PREFIX)/share/oxygen/commands $(PREFIX)/share/oxygen/src
	cp $(TARGET_BIN) $(PREFIX)/bin/oxygen
	cp src/oxygen.h $(PREFIX)/include/oxygen.h
	cp src/oxygen.h src/runtime.c src/interpreter.hpp src/interpreter.cpp $(PREFIX)/share/oxygen/src/
	cp README.md MANUAL.md LICENSE agents.md CODEOWNERS $(PREFIX)/share/oxygen/
	cp -r commands/* $(PREFIX)/share/oxygen/commands/ || true

test: $(TARGET_BIN)
	./$(TARGET_BIN) --codeowner
	./$(TARGET_BIN) --command 'print text "Oxygen build test passed"'

clean:
	rm -rf build $(TARGET_BIN)
