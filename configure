#!/usr/bin/env sh
# Oxygen Programming Language Configure Script
# Generates Makefile and src/platform_config.h for:
#   - Linux
#   - macOS (Darwin)
#   - Android (Termux / Android NDK)
#   - iOS (Darwin ARM64)
# For Windows builds, use config.h directly.

set -eu

PREFIX="/usr/local"
TARGET="auto"
CC_BIN=""
CXX_BIN=""

for arg in "$@"; do
  case "$arg" in
    --prefix=*)
      PREFIX="${arg#*=}"
      ;;
    --target=*)
      TARGET="${arg#*=}"
      ;;
    --cc=*)
      CC_BIN="${arg#*=}"
      ;;
    --cxx=*)
      CXX_BIN="${arg#*=}"
      ;;
    --help|-h)
      echo "Usage: ./configure [options]"
      echo "  --prefix=DIR      Installation prefix (default: /usr/local)"
      echo "  --target=OS       Target OS: auto, linux, macos, android, ios"
      echo "  --cc=COMPILER     C compiler override"
      echo "  --cxx=COMPILER    C++ compiler override"
      exit 0
      ;;
  esac
done

UNAME_S="$(uname -s 2>/dev/null || echo Unknown)"
UNAME_M="$(uname -m 2>/dev/null || echo unknown)"

if [ "$TARGET" = "auto" ]; then
  if [ -n "${TERMUX_VERSION:-}" ] || [ -d "/data/data/com.termux" ]; then
    TARGET="android"
  elif [ "$UNAME_S" = "Darwin" ]; then
    case "$UNAME_M" in
      iPhone*|iPad*|arm64)
        if [ -n "${IPHONEOS_DEPLOYMENT_TARGET:-}" ]; then
          TARGET="ios"
        else
          TARGET="macos"
        fi
        ;;
      *)
        TARGET="macos"
        ;;
    esac
  elif [ "$UNAME_S" = "Linux" ]; then
    TARGET="linux"
  else
    TARGET="linux"
  fi
fi

if [ -z "$CC_BIN" ]; then
  if command -v gcc >/dev/null 2>&1; then
    CC_BIN="gcc"
  elif command -v clang >/dev/null 2>&1; then
    CC_BIN="clang"
  else
    echo "Error: No C compiler (gcc or clang) found." >&2
    exit 1
  fi
fi

if [ -z "$CXX_BIN" ]; then
  if command -v g++ >/dev/null 2>&1; then
    CXX_BIN="g++"
  elif command -v clang++ >/dev/null 2>&1; then
    CXX_BIN="clang++"
  else
    echo "Error: No C++ compiler (g++ or clang++) found." >&2
    exit 1
  fi
fi

PLATFORM_LABEL="Linux"
EXTRA_CFLAGS="-O2 -Wall -Wextra -fPIC"
EXTRA_CXXFLAGS="-O2 -std=c++17 -Wall -Wextra -fPIC"
EXTRA_LDFLAGS="-lpthread -ldl"

case "$TARGET" in
  linux)
    PLATFORM_LABEL="Linux"
    ;;
  macos)
    PLATFORM_LABEL="macOS"
    EXTRA_LDFLAGS="-lpthread"
    ;;
  android)
    PLATFORM_LABEL="Android"
    EXTRA_LDFLAGS="-ldl"
    ;;
  ios)
    PLATFORM_LABEL="iOS"
    EXTRA_LDFLAGS="-lpthread"
    ;;
esac

cat > src/platform_config.h <<EOF
#ifndef OXYGEN_PLATFORM_CONFIG_H
#define OXYGEN_PLATFORM_CONFIG_H

/* Generated automatically by ./configure */
#define OXYGEN_PLATFORM_NAME "$PLATFORM_LABEL"
#define OXYGEN_PREFIX "$PREFIX"
#define OXYGEN_CXX_COMPILER "$CXX_BIN"
#define OXYGEN_C_COMPILER "$CC_BIN"
#define OXYGEN_PATH_SEP "/"
#define OXYGEN_MODULE_EXT ".so"

#endif
EOF

cat > Makefile <<EOF
# Generated by ./configure for $PLATFORM_LABEL
CC       := $CC_BIN
CXX      := $CXX_BIN
PREFIX   := $PREFIX
CFLAGS   := $EXTRA_CFLAGS -Isrc
CXXFLAGS := $EXTRA_CXXFLAGS -Isrc
LDFLAGS  := $EXTRA_LDFLAGS

TARGET_BIN := oxygen
C_SRCS     := src/runtime.c
CXX_SRCS   := src/interpreter.cpp src/compiler.cpp src/ide_server.cpp src/main.cpp
OBJS       := build/runtime.o build/interpreter.o build/compiler.o build/ide_server.o build/main.o

.PHONY: all clean install test

all: \$(TARGET_BIN)

build:
	mkdir -p build

build/runtime.o: src/runtime.c src/oxygen.h src/platform_config.h | build
	\$(CC) \$(CFLAGS) -c src/runtime.c -o build/runtime.o

build/interpreter.o: src/interpreter.cpp src/interpreter.hpp src/oxygen.h src/platform_config.h | build
	\$(CXX) \$(CXXFLAGS) -c src/interpreter.cpp -o build/interpreter.o

build/compiler.o: src/compiler.cpp src/interpreter.hpp src/oxygen.h src/platform_config.h | build
	\$(CXX) \$(CXXFLAGS) -c src/compiler.cpp -o build/compiler.o

build/ide_server.o: src/ide_server.cpp src/ide_server.hpp src/interpreter.hpp src/oxygen.h src/platform_config.h | build
	\$(CXX) \$(CXXFLAGS) -c src/ide_server.cpp -o build/ide_server.o

build/main.o: src/main.cpp src/interpreter.hpp src/ide_server.hpp src/oxygen.h src/platform_config.h | build
	\$(CXX) \$(CXXFLAGS) -c src/main.cpp -o build/main.o

\$(TARGET_BIN): \$(OBJS)
	\$(CXX) \$(CXXFLAGS) -o \$(TARGET_BIN) \$(OBJS) \$(LDFLAGS)

install: \$(TARGET_BIN)
	mkdir -p \$(PREFIX)/bin \$(PREFIX)/include \$(PREFIX)/share/oxygen/commands \$(PREFIX)/share/oxygen/src
	cp \$(TARGET_BIN) \$(PREFIX)/bin/oxygen
	cp src/oxygen.h \$(PREFIX)/include/oxygen.h
	cp src/oxygen.h src/runtime.c src/interpreter.hpp src/interpreter.cpp \$(PREFIX)/share/oxygen/src/
	cp README.md MANUAL.md LICENSE agents.md CODEOWNERS \$(PREFIX)/share/oxygen/
	cp -r commands/* \$(PREFIX)/share/oxygen/commands/ || true

test: \$(TARGET_BIN)
	./\$(TARGET_BIN) --codeowner
	./\$(TARGET_BIN) --command 'print text "Oxygen build test passed"'

clean:
	rm -rf build \$(TARGET_BIN)
EOF

echo "Configured Oxygen for $PLATFORM_LABEL (CC=$CC_BIN, CXX=$CXX_BIN, PREFIX=$PREFIX)"
echo "Makefile and src/platform_config.h generated. Run 'make' to build the oxygen binary."
